# Copy to .env and fill in. .env is git-ignored and only read by the Open Rock server.

# Optional: a server (Ollama, vLLM, llama.cpp…) to start the Dedicated server list with. Servers are normally added in
# Settings → Dedicated (hostname or IP, HTTPS port, token). This one is added on first run, and baked into the
# desktop app at build time. The token is used only for this host, and only when its Token field in Settings is empty.
# OPEN_ROCK_DEDICATED_HOST=
# OPEN_ROCK_DEDICATED_TOKEN=

# Optional: Amazon Bedrock API key (Variable mode). You can also paste it in Settings → Variable.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1

# Website deployments
# OPEN_ROCK_HOST=0.0.0.0          # listen on all interfaces (default 127.0.0.1)
# OPEN_ROCK_PORT=8787
# OPEN_ROCK_AUTH_TOKEN=           # strongly recommended when the site is reachable by others
# OPEN_ROCK_DATA_DIR=./data       # chats, uploads, usage and settings (default ~/.open-rock)
# OPEN_ROCK_MAX_UPLOAD_MB=50
# OPEN_ROCK_ALLOWED_ORIGINS=      # extra origins allowed to call the API, comma separated
